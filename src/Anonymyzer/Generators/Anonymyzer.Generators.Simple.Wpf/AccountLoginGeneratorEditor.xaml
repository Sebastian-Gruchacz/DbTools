<UserControl x:Class="Anonymyzer.Generators.Simple.Wpf.AccountLoginGeneratorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="Creates an opaque login or uses name columns. Generated makes the planner run name producers first." />
        <TextBlock Grid.Row="1" Margin="0,0,12,8" Text="Pattern:" /><ComboBox x:Name="PatternComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Margin="0,0,12,8" Text="Opaque prefix:" /><TextBox x:Name="OpaquePrefixTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="3" Margin="0,0,12,8" Text="First-name column:" /><TextBox x:Name="FirstNameColumnTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="4" Margin="0,0,12,8" Text="Last-name column:" /><TextBox x:Name="LastNameColumnTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="5" Margin="0,0,12,8" Text="Name values:" /><ComboBox x:Name="NameValueSourceComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="6" Margin="0,0,12,8" Text="Separator:" /><TextBox x:Name="SeparatorTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="7" Margin="0,0,12,8" Text="Start / digits:" />
        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="StartAtTextBox" Width="110" Margin="0,0,8,0" /><TextBox x:Name="MinimumDigitsTextBox" Width="80" />
        </StackPanel>
        <CheckBox x:Name="PreserveNullsCheckBox" Grid.Row="8" Grid.ColumnSpan="2" Content="Preserve null positions" />
    </Grid>
    </ScrollViewer>
</UserControl>
