<UserControl x:Class="Anonymyzer.Generators.Simple.Wpf.JsonPathRedactorGeneratorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,14"
                   TextWrapping="Wrap"
                   Text="Replaces selected values inside JSON stored in a text column. Paths use the same syntax as the sample profiler: $/property, $/array[]/property, with ~0 for ~ and ~1 for /. Replacement is a JSON literal, so strings need quotes." />

        <DataGrid x:Name="RulesGrid"
                  Grid.Row="1"
                  MinHeight="180"
                  CanUserAddRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Width="2*" Header="Path" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Width="3*" Header="Replacement JSON" Binding="{Binding ReplacementJson, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,10" Orientation="Horizontal">
            <Button Width="90" Margin="0,0,8,0" Click="AddRule_Click" Content="Add rule" />
            <Button Width="110" Click="RemoveRule_Click" Content="Remove rule" />
        </StackPanel>

        <CheckBox x:Name="RequireEveryPathCheckBox"
                  Grid.Row="3"
                  Content="Fail a row when any configured path is missing" />
    </Grid>
</UserControl>
