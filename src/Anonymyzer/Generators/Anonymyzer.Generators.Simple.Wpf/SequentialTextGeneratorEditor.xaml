<UserControl x:Class="Anonymyzer.Generators.Simple.Wpf.SequentialTextGeneratorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,14"
                   TextWrapping="Wrap"
                   Text="Generates unique sequential text within one execution session, for example anon-00000001. Values depend on processing order." />

        <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="Prefix:" />
        <TextBox x:Name="PrefixTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="Suffix:" />
        <TextBox x:Name="SuffixTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Margin="0,0,12,8" VerticalAlignment="Center" Text="Start at:" />
        <TextBox x:Name="StartAtTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" Margin="0,0,12,8" VerticalAlignment="Center" Text="Minimum digits:" />
        <TextBox x:Name="MinimumDigitsTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

        <CheckBox x:Name="PreserveNullsCheckBox"
                  Grid.Row="5"
                  Grid.ColumnSpan="2"
                  Content="Preserve null positions" />
    </Grid>
</UserControl>
