<UserControl x:Class="Anonymyzer.Generators.Person.Wpf.NationalIdentifierGeneratorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="Generates synthetic national identifiers. pl-PL produces checksum-valid PESEL values. en-US produces safely unassigned 000-prefix SSN-shaped values, which strict SSN validators may reject." />

        <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="Locale:" />
        <ComboBox x:Name="LocaleComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsEditable="True" />

        <TextBlock Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="Minimum birth date:" />
        <TextBox x:Name="MinimumBirthDateTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Margin="0,0,12,8" VerticalAlignment="Center" Text="Maximum birth date:" />
        <TextBox x:Name="MaximumBirthDateTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" Margin="0,0,12,8" VerticalAlignment="Center" Text="Gender:" />
        <ComboBox x:Name="GenderComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="5" Margin="0,0,12,8" VerticalAlignment="Center" Text="Seed:" />
        <TextBox x:Name="SeedTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="6" Margin="0,0,12,8" VerticalAlignment="Center" Text="Birth-date column:" />
        <TextBox x:Name="BirthDateColumnTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="7" Margin="0,0,12,8" VerticalAlignment="Center" Text="Birth-date values:" />
        <ComboBox x:Name="BirthDateValueSourceComboBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="8" Margin="0,0,12,8" VerticalAlignment="Center" Text="Gender column:" />
        <TextBox x:Name="GenderColumnTextBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="9" Margin="0,0,12,8" VerticalAlignment="Center" Text="Gender values:" />
        <ComboBox x:Name="GenderValueSourceComboBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="10" Margin="0,0,12,8" VerticalAlignment="Center" Text="Female mappings:" />
        <TextBox x:Name="FemaleValuesTextBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="11" Margin="0,0,12,8" VerticalAlignment="Center" Text="Male mappings:" />
        <TextBox x:Name="MaleValuesTextBox" Grid.Row="11" Grid.Column="1" Margin="0,0,0,8" />

        <CheckBox x:Name="PreserveNullsCheckBox" Grid.Row="12" Grid.ColumnSpan="2"
                  Content="Preserve null positions" />
    </Grid>
</UserControl>
