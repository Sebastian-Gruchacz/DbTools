<UserControl x:Class="Anonymyzer.Generators.Person.Wpf.BirthDateGeneratorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="Generates a date-only value. NationalIdentifier can consume the generated column to create a matching PESEL." />

        <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="Minimum date:" />
        <TextBox x:Name="MinimumDateTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="Maximum date:" />
        <TextBox x:Name="MaximumDateTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Margin="0,0,12,8" VerticalAlignment="Center" Text="Seed:" />
        <TextBox x:Name="SeedTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

        <CheckBox x:Name="PreserveNullsCheckBox" Grid.Row="4" Grid.ColumnSpan="2"
                  Content="Preserve null positions" />
    </Grid>
</UserControl>
