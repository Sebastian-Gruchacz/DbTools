<Window x:Class="Anonymyzer.ConfigEditor.GeneratorProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generator profiles"
        Width="920"
        Height="520"
        MinWidth="720"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Content="Add" Click="Add_Click" />
            <Button Width="90" Margin="0,0,8,0" Content="Remove" Click="Remove_Click" />
            <Button Width="110" Margin="0,0,24,0" Content="Configure..." Click="Configure_Click" />
            <Button Width="90" Margin="0,0,8,0" Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button Width="90" Content="Cancel" IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="Profiles are reusable parameter sets. Options must be a JSON object; locale may be empty for locale-independent generators." />

        <DataGrid x:Name="ProfilesGrid"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="1.1*" />
                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="1.2*" />
                <DataGridTextColumn Header="Generator type" Binding="{Binding GeneratorType}" Width="1.1*" />
                <DataGridTextColumn Header="Version" Binding="{Binding GeneratorVersion}" Width="80" />
                <DataGridTextColumn Header="Locale" Binding="{Binding Locale}" Width="90" />
                <DataGridTextColumn Header="Options JSON" Binding="{Binding OptionsJson}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
