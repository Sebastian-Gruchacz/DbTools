<Window x:Class="Anonymyzer.ConfigEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="520"
        Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Rescan detached clone..." Click="Rescan_Click" />
                <Separator />
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Click="SaveAs_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Generators">
                <MenuItem Header="_Profiles..." Click="Profiles_Click" />
                <MenuItem Header="_Language packs..." Click="LanguagePacks_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Table marking _legend" Click="TableLegend_Click" />
                <MenuItem Header="Online _documentation" Click="Documentation_Click" />
                <Separator />
                <MenuItem Header="_About Anonymyzer" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" />
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="Table:" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Tables}"
                          SelectedItem="{Binding SelectedTable}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinWidth="380" ToolTip="{Binding CandidateDetails}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="DarkOrange"
                                           Text="{Binding CandidateMark}" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           Foreground="SteelBlue"
                                           Text="{Binding ManualMark}"
                                           ToolTip="{Binding ManualDetails}" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Center"
                                           Foreground="Firebrick"
                                           Text="{Binding SchemaWarningMark}"
                                           ToolTip="{Binding SchemaWarningDetails}" />
                                <TextBlock Grid.Column="3"
                                           Margin="0,0,8,0"
                                           HorizontalAlignment="Right"
                                           Foreground="DarkOrange"
                                           FontWeight="SemiBold"
                                           Text="{Binding CandidateCountText}" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding QualifiedName}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Filter:" />
                    <TextBox Width="150"
                             Margin="0,0,12,0"
                             Text="{Binding TableFilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Content="{Binding CandidateTablesOnlyLabel}"
                              IsChecked="{Binding ShowCandidateTablesOnly}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="DimGray"
                               Text="{Binding TableFilterSummary}" />
                </WrapPanel>
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <CheckBox Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Content="Anonymize table"
                              IsChecked="{Binding SelectedTable.Enabled}" />
                    <Button Width="110" Margin="0,0,8,0" Content="Edit groups..." Click="Groups_Click" />
                    <Button Width="115" Margin="0,0,8,0" Content="Add column ▾" Click="AddColumns_Click" />
                    <Button Width="120" Margin="0,0,14,0" Content="Refresh sample" Click="RefreshSample_Click" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="DimGray"
                               Text="● + count = automatic candidates; ◆ = operator choices; ⚠ = absent in latest rescan" />
                </StackPanel>
            </Grid>

            <DataGrid x:Name="ColumnsGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding SelectedTable.Columns}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="False"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" IsReadOnly="True" Width="68">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Foreground="DarkOrange"
                                               Text="{Binding CandidateMark}"
                                               ToolTip="{Binding CandidateDetails}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="SteelBlue"
                                               Text="{Binding ManualMark}"
                                               ToolTip="{Binding ManualDetails}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="Firebrick"
                                               Text="{Binding SchemaWarningMark}"
                                               ToolTip="{Binding SchemaWarningDetails}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" IsReadOnly="True" Width="45" />
                    <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" IsReadOnly="True" Width="1.4*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" IsReadOnly="True" Width="105" />
                    <DataGridCheckBoxColumn Header="Anonymize" Binding="{Binding Enabled}" Width="80" />
                    <DataGridTemplateColumn Header="Semantic role" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Padding="5,1"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="{Binding SemanticRoleDisplay}"
                                        ToolTip="{Binding SemanticRoleValue}"
                                        Click="SemanticRole_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Group" Binding="{Binding GenerationGroupId}" Width="100" />
                    <DataGridTemplateColumn Header="Generator" Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.GeneratorTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding GeneratorType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Profile" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ProfileIds, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sample" Binding="{Binding Sample}" IsReadOnly="True" Width="1.2*" />
                    <DataGridTemplateColumn Header="Values" IsReadOnly="True" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Padding="5,1" Content="View..." Click="ViewValues_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
