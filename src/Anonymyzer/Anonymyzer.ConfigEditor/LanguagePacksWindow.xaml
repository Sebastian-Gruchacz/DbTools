<Window x:Class="Anonymyzer.ConfigEditor.LanguagePacksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Language packs"
        Width="720"
        Height="430"
        MinWidth="620"
        MinHeight="330"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Language-pack DLLs contain executable code. Install only libraries from a trusted source. Changes take effect after restarting Anonymyzer." />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,8,0" Content="Install DLL..." Click="Install_Click" />
            <Button Width="105" Margin="0,0,18,0" Content="Remove..." Click="Remove_Click" />
            <Button Width="90" Margin="0,0,8,0" IsDefault="True" Content="Apply" Click="Apply_Click" />
            <Button Width="90" IsCancel="True" Content="Cancel" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="PacksGrid"
                      ItemsSource="{Binding Packs}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="75" />
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" IsReadOnly="True" Width="1.5*" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" IsReadOnly="True" Width="80" />
                    <DataGridTextColumn Header="Locales" Binding="{Binding Locales}" IsReadOnly="True" Width="1.1*" />
                    <DataGridTextColumn Header="Profiles" Binding="{Binding ProfileCount}" IsReadOnly="True" Width="65" />
                    <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" IsReadOnly="True" Width="95" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="DarkGoldenrod" TextWrapping="Wrap"
                       Text="{Binding Warnings}" />
        </Grid>
    </DockPanel>
</Window>
