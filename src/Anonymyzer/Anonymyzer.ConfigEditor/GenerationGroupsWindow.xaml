<Window x:Class="Anonymyzer.ConfigEditor.GenerationGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generation groups"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button Width="90" Content="Cancel" IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,10"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Text="A group maps coherent generator outputs. Enable the table and every bound column in the main grid before execution." />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="100" Margin="0,0,8,0" Content="Add group" Click="AddGroup_Click" />
                    <Button Width="110" Content="Remove group" Click="RemoveGroup_Click" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Groups" />
            </DockPanel>

            <DataGrid x:Name="GroupsGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup}"
                      SelectionChanged="GroupsGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="1.1*" />
                    <DataGridTemplateColumn Header="Profile" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ProfileIds, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="Profile_SelectionChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Locale override" Binding="{Binding Locale}" Width="1*" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="0,12,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="110" Margin="0,0,8,0" Content="Add binding" Click="AddBinding_Click" />
                    <Button Width="120" Content="Remove binding" Click="RemoveBinding_Click" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Output bindings" />
            </DockPanel>

            <DataGrid x:Name="BindingsGrid"
                      Grid.Row="3"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Generator output" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.SelectedOutputOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding Output, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Table column" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ColumnOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding ColumnName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
