<Window x:Class="Anonymyzer.ConfigEditor.AddColumnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add columns from detached clone"
        Width="680"
        Height="480"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontWeight="SemiBold" Text="{Binding Target}" />
            <TextBlock Margin="0,4,0,10"
                       Foreground="DimGray"
                       Text="Only unconfigured, non-primary-key columns are listed. The database is read-only." />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Connection env:" />
                <TextBox x:Name="ConnectionEnvironmentTextBox"
                         Grid.Column="1"
                         MinWidth="220"
                         Text="ANONYMYZER_CONNECTION" />
                <Button x:Name="LoadButton"
                        Grid.Column="2"
                        Width="90"
                        Margin="8,0,0,0"
                        Content="Load"
                        Click="Load_Click" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" Margin="0,0,0,8" Foreground="DimGray" Text="Load metadata from the clone." />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
                <Button Width="110" Content="Add selected" IsDefault="True" Click="AddSelected_Click" />
            </StackPanel>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Columns}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Add" Binding="{Binding IsSelected}" Width="55" />
                <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" IsReadOnly="True" Width="50" />
                <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
