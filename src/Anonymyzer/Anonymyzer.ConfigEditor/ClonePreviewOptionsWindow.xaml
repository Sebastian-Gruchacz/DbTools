<Window x:Class="Anonymyzer.ConfigEditor.ClonePreviewOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generator preview from clone"
        Width="470"
        Height="230"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,14"
                   TextWrapping="Wrap"
                   Text="The selected table uses a generator that needs existing values. A small read-only sample will be loaded after validating the detached-copy marker." />

        <TextBlock Grid.Row="1" Margin="0,0,10,8" VerticalAlignment="Center" Text="Connection env:" />
        <TextBox x:Name="ConnectionEnvironmentTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Margin="0,0,10,8" VerticalAlignment="Center" Text="Sample rows:" />
        <TextBox x:Name="MaximumRowsTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Text="Allowed range: 2–50. The connection string is read from the environment and is never stored in the configuration." />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="82" Margin="0,0,8,0" IsDefault="True" Content="Preview" Click="Preview_Click" />
            <Button Width="82" IsCancel="True" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
