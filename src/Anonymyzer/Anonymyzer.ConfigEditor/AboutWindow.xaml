<Window x:Class="Anonymyzer.ConfigEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Anonymyzer"
        Width="520"
        Height="310"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Anonymyzer Configuration Editor" />
        <TextBlock x:Name="VersionTextBlock" Grid.Row="1" Margin="0,8,0,0" />
        <TextBlock Grid.Row="2" Margin="0,4,0,0" Text="Author: Sebastian Gruchacz" />
        <TextBlock Grid.Row="3" Margin="0,18,0,0" TextWrapping="Wrap"
                   Text="A clone-first database anonymization tool. Please report unusual schemas, provider edge cases and unexpected mappings in the project issue tracker." />

        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/Sebastian-Gruchacz/DbTools"
                           RequestNavigate="Link_RequestNavigate">GitHub project and issue tracker</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,7,0,0">
                <Hyperlink NavigateUri="https://github.com/Sebastian-Gruchacz/DbTools#readme"
                           RequestNavigate="Link_RequestNavigate">Documentation</Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="5" Width="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Content="Close" />
    </Grid>
</Window>
